{
  "name": "ast-visualizer",
  "version": "2.0.0",
  "description": "A tool to visualize Abstract Syntax Trees (ASTs) for JavaScript code",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "ast",
    "visualizer",
    "javascript",
    "esprima",
    "d3"
  ],
  "author": "Viswesh",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/dom": "^10.4.1",
    "@types/d3": "^7.4.3",
    "@types/esprima": "^4.0.6",
    "@types/jquery": "^3.5.29",
    "@types/node": "^25.0.10",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.2.10",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "codeflask": "^1.4.1",
    "d3": "^7.9.0",
    "esprima": "^4.0.1",
    "jquery": "^3.7.1",
    "materialize-css": "^1.0.0",
    "prismjs": "^1.29.0"
  }
}
